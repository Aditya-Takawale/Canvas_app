# Database - Using SQLite for development
DATABASE_URL="file:./dev.db"

# JWT
JWT_SECRET="your-super-secret-jwt-key-here"
JWT_EXPIRES_IN="30d"

# Server
PORT=5000
NODE_ENV=development

# Request body size limit for JSON/urlencoded payloads (e.g., large canvas state)
# Examples: 5mb, 10mb, 25mb
# MAX_BODY_SIZE=25mb