# Environment
NODE_ENV=development
PORT=5000

# Database - Choose your database type and update the URL
# For bundled SQLite dev DB, the file resides in prisma/dev.db (matches schema.prisma)
DATABASE_URL="file:./prisma/dev.db"
# For MySQL: DATABASE_URL=mysql://username:password@localhost:3306/canvas_app
# For PostgreSQL: DATABASE_URL=postgresql://username:password@localhost:5432/canvas_app

# JWT - CRITICAL: Generate a strong, unique secret!
# Minimum 24 characters enforced in production by validateEnv.
# Example dev secret below (replace in real deployments)
JWT_SECRET="dev_super_secret_token_please_change_123456789"
JWT_EXPIRES_IN=30d

# CORS - multiple origins comma-separated
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# Request body size limit for large canvas data
# MAX_BODY_SIZE=25mb

# SECURITY SETUP INSTRUCTIONS:
# 1. Copy this file to .env: cp .env.example .env
# 2. (Production) Generate a secure JWT_SECRET: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# 3. Update DATABASE_URL with your actual database credentials
# 4. NEVER commit the .env file to git!