# Backend Environment Variables for Railway Production
# Copy these values to Railway dashboard Environment Variables

# Database (Use the PostgreSQL connection URL from Railway)
# Format: postgresql://postgres:password@host:port/database
DATABASE_URL=postgresql://postgres:***@tramay.proxy.rlwy.net:31004/railway

# Server Configuration
NODE_ENV=production
PORT=5000

# Authentication - Generate a strong secret key
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters-long

# CORS Settings - Update after deploying frontend to Vercel
FRONTEND_URL=https://your-vercel-app-name.vercel.app

# Logging
LOG_LEVEL=info

# Example with actual Railway PostgreSQL format:
# DATABASE_URL=postgresql://postgres:ZEcSkBXsHmThdeNxDwKnyNNVAazQxXsR@tramay.proxy.rlwy.net:31004/railway